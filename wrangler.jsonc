{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scenering",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scenering-db",
      "database_id": "PLACEHOLDER_RUN_SETUP_SCRIPT",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITS",
      "id": "c0b74485bcc9428582acb39e210a480e"
    }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://scenering.com",
    "EMAIL_PROVIDER": "console"
  }
}
