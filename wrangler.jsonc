{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scenering",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat (+ a compatibility date of 2025-08-15 or later) provides
  // node:crypto, node:http and the `cloudflare:node` bridge module that
  // worker.ts uses to run the Express app — see CLOUDFLARE.md.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Paths the Worker must handle BEFORE the static-asset layer. With
    // `not_found_handling: "single-page-application"` every non-asset path is
    // otherwise answered with the SPA shell (index.html, HTTP 200) — which
    // would silently swallow the Express routes below:
    //   /api/* and /functions/v1/*  — the whole JSON API (the legacy
    //                                /functions/v1 paths stay routable for
    //                                clients saved before the migration)
    //   /robots.txt, /sitemap.xml   — served by Express (registerPlatformRoutes);
    //                                as SPA fallback they would return HTML
    //                                with a 200 and break crawlers
    "run_worker_first": [
      "/api/*",
      "/functions/v1/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  // Cron Triggers: worker.ts's `scheduled` handler dispatches on the
  // expression. "0 * * * *" sweeps custom voice-import uploads whose 24h
  // retention window has passed (R2 object + D1 bookkeeping row) — the only
  // expiry path for that storage. "*/5 * * * *" drains the Email Centre's
  // campaign queue: starts due scheduled campaigns and sends the next
  // bounded batch of campaigns mid-send, so a large marketing send is never
  // one unbounded synchronous request.
  "triggers": {
    "crons": ["0 * * * *", "*/5 * * * *"]
  },
  // Workers Logs: invocation logs, console output and errors in the
  // dashboard, with no tail command to keep running.
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scenering-db",
      // The real scenering-db id (from the Cloudflare dashboard). The setup
      // script leaves real values untouched and only fills placeholders.
      "database_id": "9db6d98a-783c-4974-aaee-d56cfcf76e43",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITS",
      // The production RATE_LIMITS namespace, restored from commit 4d28fea
      // ("Set real KV namespace ID") — PR #35's placeholder round-trip left a
      // value the Cloudflare API rejects with error 10042.
      "id": "c0b74485bcc9428582acb39e210a480e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "scenering-audio"
    }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://scenering.com",
    "SCENERING_OWNER_EMAIL": "hjvhorlick@gmail.com",
    "EMAIL_PROVIDER": "resend",
    // Paddle's environment selector: "sandbox" or "live", paired with
    // PADDLE_CLIENT_ENVIRONMENT ("sandbox" or "production") for Paddle.js.
    // Plain vars, not secrets — they name which Paddle account the secrets
    // belong to, and the owner's billing checklist shows them. Set the live
    // API key, client token (live_…), price ids, approved checkout URLs and
    // webhook secret key with `wrangler secret put` (see PADDLE.md).
    "PADDLE_ENVIRONMENT": "live",
    "PADDLE_CLIENT_ENVIRONMENT": "production",
    // FastSpring, the optional second merchant of record (see FASTSPRING.md).
    // Plain vars, not secrets — they name which storefront to open and which
    // provider checkout should use first; the webhook secret and API
    // credentials go in with `wrangler secret put`. Empty values leave the
    // existing Paddle checkout exactly as it is.
    "BILLING_PROVIDER": "",
    "FASTSPRING_STOREFRONT": ""
  },
  // Worker Previews have their own data stores. These IDs are filled by
  // `bash scripts/setup-preview-resources.sh`; do not point them at production.
  // Vars are intentionally preview-safe: no live email or billing provider.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "scenering-db-preview",
        "database_id": "SCENERING_D1_PREVIEW_ID_PLACEHOLDER",
        "migrations_dir": "./migrations"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "RATE_LIMITS",
        "id": "SCENERING_KV_PREVIEW_ID_PLACEHOLDER"
      }
    ],
    "r2_buckets": [
      {
        "binding": "AUDIO_BUCKET",
        "bucket_name": "scenering-audio-preview"
      }
    ],
    "vars": {
      "PUBLIC_APP_URL": "",
      "SCENERING_OWNER_EMAIL": "",
      "EMAIL_PROVIDER": "console",
      "PADDLE_ENVIRONMENT": "sandbox",
      "PADDLE_CLIENT_ENVIRONMENT": "sandbox",
      "BILLING_PROVIDER": "",
      "FASTSPRING_STOREFRONT": ""
    }
  }
}
