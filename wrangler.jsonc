{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scenering",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat (+ a compatibility date of 2025-08-15 or later) provides
  // node:crypto, node:http and the `cloudflare:node` bridge module that
  // worker.ts uses to run the Express app — see CLOUDFLARE.md.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Paths the Worker must handle BEFORE the static-asset layer. With
    // `not_found_handling: "single-page-application"` every non-asset path is
    // otherwise answered with the SPA shell (index.html, HTTP 200) — which
    // would silently swallow the Express routes below:
    //   /api/* and /functions/v1/*  — the whole JSON API (the legacy
    //                                /functions/v1 paths stay routable for
    //                                clients saved before the migration)
    //   /robots.txt, /sitemap.xml   — served by Express (registerPlatformRoutes);
    //                                as SPA fallback they would return HTML
    //                                with a 200 and break crawlers
    "run_worker_first": [
      "/api/*",
      "/functions/v1/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  // Cron Triggers: worker.ts's `scheduled` handler dispatches on the
  // expression. "0 * * * *" sweeps custom voice-import uploads whose 24h
  // retention window has passed (R2 object + D1 bookkeeping row) — the only
  // expiry path for that storage. "15 * * * *" drains the Email Centre's
  // campaign queue: starts due scheduled campaigns and sends the next
  // bounded batch of campaigns mid-send, so a large marketing send is never
  // one unbounded synchronous request. Hourly (not every five minutes) since
  // the pre-launch traffic review: scheduled campaigns and programme emails
  // may start up to an hour late, which costs nothing at this stage and
  // cuts the always-on cron from 288 to 24 invocations a day; raise it again
  // when campaign volume makes the wait matter.
  "triggers": {
    "crons": ["0 * * * *", "15 * * * *"]
  },
  // Workers Logs: invocation logs, console output and errors in the
  // dashboard, with no tail command to keep running.
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scenering-db",
      // The real scenering-db id (from the Cloudflare dashboard). The setup
      // script leaves real values untouched and only fills placeholders.
      "database_id": "9db6d98a-783c-4974-aaee-d56cfcf76e43",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITS",
      // The production RATE_LIMITS namespace, restored from commit 4d28fea
      // ("Set real KV namespace ID") — PR #35's placeholder round-trip left a
      // value the Cloudflare API rejects with error 10042.
      "id": "c0b74485bcc9428582acb39e210a480e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "scenering-audio"
    }
  ],
  "vars": {
    // The deployed server must say it is production. Every development
    // affordance (auto-owner preview sessions, sandbox account provisioning,
    // verification/reset links echoed in API responses, relaxed cookies) is
    // gated on this, and the runtime treats an unset value as production too —
    // belt and braces, because a live site with a development flag is the
    // expensive failure mode. Local `wrangler dev` overrides it in `.dev.vars`
    // (see .dev.vars.example).
    "NODE_ENV": "production",
    "PUBLIC_APP_URL": "https://scenering.com",
    "SCENERING_OWNER_EMAIL": "hjvhorlick@gmail.com",
    "EMAIL_PROVIDER": "resend",
    "PAYPAL_ENVIRONMENT": "sandbox"
  },
  // Worker Previews: what Workers Builds deploys for every branch other than
  // main (`npx wrangler preview`). Wrangler 4.147+ refuses to run that command
  // without this block — "Your Wrangler configuration is missing a `previews`
  // block" — so the block must stay, even while it is small. Previews inherit
  // nothing from the top level except `assets` and the compatibility settings:
  // vars and storage bindings exist only where they are repeated in here.
  //
  // Preview-only D1, KV, and R2 resources are isolated from production.
  // Never point preview bindings at production: branch code would otherwise
  // read and write live customer data. The setup script can replace the
  // generated bindings between the markers if resources are recreated.
  "previews": {
    // setup-preview-resources:bindings (generated by scripts/setup-preview-resources.sh — leave both markers in place)
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "scenering-db-preview",
        "database_id": "cb2d97ad-74ff-45df-a20e-44643cf5352f",
        "migrations_dir": "./migrations"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "RATE_LIMITS",
        "id": "aea03c6b85fd4e48b1f2000e44970b79"
      }
    ],
    "r2_buckets": [
      {
        "binding": "AUDIO_BUCKET",
        "bucket_name": "scenering-audio-preview"
      }
    ],
    // setup-preview-resources:bindings-end
    "vars": {
      "NODE_ENV": "development",
      "PUBLIC_APP_URL": "https://arena-bbec8b11-scenering-scenering.sceneweaver.workers.dev",
      "SCENERING_OWNER_EMAIL": "",
      "EMAIL_PROVIDER": "console",
      "PAYPAL_ENVIRONMENT": "sandbox",
      "PAYPAL_CLIENT_ID": "Ad9rjMaQ9CsPbXPSKt-EjYTcaYVyoAlPSKrKgVx7SjF-otxi9DJ_0L9PIiUFbRoEPs2AvWnkNvQ9KL8m",
      "PAYPAL_PREVIEW_SINGLE_PLAN_MODE": "true",
      "PAYPAL_SCENEFLOW_MONTHLY_PLAN_ID": "P-6J340466VT137933ENLRWTEI"
    }
  }
}
