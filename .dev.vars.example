# Copy this file to .dev.vars for local `npx wrangler dev` runs.
# Never commit .dev.vars — it is gitignored.
#
# In production, set each of these with `npx wrangler secret put <NAME>`.

# This file is a DEVELOPMENT machine. Production defaults to production mode
# when NODE_ENV is unset; only say "development" here.
NODE_ENV=development

# The local Vite reverse proxy is the only trusted proxy. It forwards the
# preview host/protocol for same-origin checks and secure cookies.
TRUST_PROXY=1
DEV_EMBEDDED_PREVIEW=1
# Let the current local/preview request host define its own link origin.
PUBLIC_APP_URL=

# Required in production (≥ 32 chars — e.g. `openssl rand -hex 32`).
# The server reads SESSION_SECRET; SCENERING_AUTH_SECRET is only a legacy
# alias, never the name to configure a deployment with.
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# The one verified local account that may open /admin. Replace with a mailbox
# you can use while developing; matching the address does not skip verification.
SCENERING_OWNER_EMAIL=owner@example.test

# Optional server-side stock media fallbacks (users can also supply their own
# keys in the studio's API-keys modal; Speechify is always browser-held):
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Email delivery (EMAIL_PROVIDER in wrangler.jsonc defaults to "resend"; for
# local dev you can override it here to "console" to log links to stdout):
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Optional Resend webhook signing secret (whsec_...) for /api/webhooks/resend:
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Scenering <noreply@scenering.com>
EMAIL_REPLY_TO=support@scenering.com

# PayPal subscriptions are Sandbox-only and must remain disabled in production.
# Keep Client Secret and Webhook ID in server-side secrets, never VITE_* vars.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SCENEFLOW_MONTHLY_PLAN_ID=
PAYPAL_SCENEFLOW_YEARLY_PLAN_ID=
PAYPAL_SCENEFORGE_MONTHLY_PLAN_ID=
PAYPAL_SCENEFORGE_YEARLY_PLAN_ID=
