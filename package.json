{
  "name": "scenering",
  "private": true,
  "version": "1.1.0",
  "license": "UNLICENSED",
  "author": "Henry John Vincent Horlick",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-theme-css.mjs && concurrently -n vite,worker -c blue,green \"vite build --watch\" \"wrangler dev --live-reload\"",
    "build": "node scripts/generate-theme-css.mjs && vite build",
    "start": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "worker:typecheck": "tsc -p tsconfig.worker.json",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "theme:css": "node scripts/generate-theme-css.mjs",
    "marketing:assets": "node scripts/optimize-marketing-assets.mjs",
    "nature:assets": "node scripts/optimize-nature-assets.mjs",
    "marketing:og": "node scripts/make-og-card.mjs",
    "test": "tsx tests/run-all.ts",
    "verify": "tsc --noEmit && tsc -p tsconfig.worker.json && tsx tests/run-all.ts && npm run build && wrangler deploy --dry-run",
    "brand:check": "esbuild src/lib/render-effects.ts --bundle --format=esm --outfile=public/brand-mark.mjs --loader:.png=dataurl --loader:.jpg=dataurl --log-level=silent"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@supabase/supabase-js": "^2.45.4",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "wrangler": "^4.147.0"
  }
}
