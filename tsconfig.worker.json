{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental", "node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": [
    "worker.ts",
    "server.ts",
    "server/platform.ts",
    "server/email.ts",
    "src/env.ts",
    "src/db.ts",
    "src/rate-limiter.ts",
    "src/audio-store.ts",
    "src/config/plans.ts",
    "src/data/nature-fallbacks.ts",
    "src/lib/speech-sanitizer.ts",
    "src/lib/phonetic-dictionary.ts",
    "src/lib/word-sync.ts"
  ],
  "exclude": ["node_modules"]
}
