# Optional media providers
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Narration is bring-your-own-key: customers supply their own free Google AI
# Studio key in the app. This secret is used only for the owner administrator
# account (SCENERING_OWNER_EMAIL).
GEMINI_API_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Hosted account/session configuration
PUBLIC_APP_URL=
SESSION_SECRET=
# Exact email address for Henry John Vincent Horlick's owner-admin account.
# Only this server-side address receives administrator role and SceneForge access.
SCENERING_OWNER_EMAIL=

# Email delivery. Production uses Resend's HTTPS API (compatible with
# Cloudflare Workers); keep EMAIL_PROVIDER=console if you only want messages
# printed locally. RESEND_API_KEY is a server-side secret: put it in .dev.vars
# for local Resend testing, or set it in Cloudflare from your own terminal.
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Lemon Squeezy — server-side secrets only, never exposed to the browser.
# On Cloudflare Workers these are set with `wrangler secret put <NAME>`
# (locally they go in .dev.vars); this file documents the names and the loop.
#
# Going live, in order:
#  1. Create one product per plan with a monthly and a yearly variant.
#  2. Copy each variant's numeric id into the VARIANT_ID entries below, and
#     each variant's share/checkout link into the matching CHECKOUT_URL. The
#     server appends checkout[email] and checkout[custom][user_id], which is
#     how a payment is matched back to a Scenering account.
#  3. Add a webhook pointing at  <PUBLIC_APP_URL>/api/webhooks/lemonsqueezy
#     and tick every subscription_* event:
#       subscription_created, subscription_updated, subscription_cancelled,
#       subscription_resumed, subscription_expired, subscription_paused,
#       subscription_unpaused, subscription_payment_failed,
#       subscription_payment_success, subscription_payment_recovered
#     Put its signing secret in LEMON_SQUEEZY_WEBHOOK_SECRET.
#  4. Sign in as the owner and open Account & Membership — the administration
#     panel shows a checklist of exactly what is still missing.
#
# The API key and store id are not required for checkout or webhooks; they are
# here for future server-to-server calls.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_SCENEFLOW_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_SCENEFLOW_YEARLY_VARIANT_ID=
LEMON_SQUEEZY_SCENEFORGE_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_SCENEFORGE_YEARLY_VARIANT_ID=
LEMON_SQUEEZY_SCENEFLOW_MONTHLY_CHECKOUT_URL=
LEMON_SQUEEZY_SCENEFLOW_YEARLY_CHECKOUT_URL=
LEMON_SQUEEZY_SCENEFORGE_MONTHLY_CHECKOUT_URL=
LEMON_SQUEEZY_SCENEFORGE_YEARLY_CHECKOUT_URL=
