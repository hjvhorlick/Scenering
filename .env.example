# Scenering environment configuration
# Copy to .env for local development. Never commit real credentials.

NODE_ENV="development"
PUBLIC_APP_URL="http://localhost:3000"

# Required for session signing, verification-token hashing and complimentary-code hashing in production.
# Generate with: openssl rand -hex 32
# SESSION_SECRET is the production name. SCENERING_AUTH_SECRET is a legacy
# development alias only and must not be used for a deployment.
SESSION_SECRET="replace-with-a-random-32-byte-secret"

# Owner administrator email. Set this to the mailbox you control. Register or
# sign in with this exact address, then complete its email-verification link;
# matching the address alone never grants administrator access.
SCENERING_OWNER_EMAIL="owner@example.com"

#Google AdSense (build-time — NOT a secret; these ship in the page)
#The verification tag — the adsbygoogle.js loader with this site's publisher
#id — and ads.txt live in the committed HTML/public files (index.html,
#public/render-probe.html, public/brand-check.html, public/icon-sheet.html and
#public/ads.txt), pasted there literally so every plain build ships them.
#These three values gate the ad UNITS only, and advertising stays off until
#you fill them in: the publisher id plus the data-ad-slot numbers from your
#AdSense account (one unit on the public webpages, plus free-plan studio side
#rails), then REBUILD (npm run deploy). A blank value keeps that placement
#off. AdSlot checks for the pasted loader by src before loading anything, so
#setting these never adds a second adsbygoogle.js to the page.
#In AdSense → Privacy & messaging, turn on a consent message for EEA/UK
#visitors before enabling this.
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_SLOT_WEB=""
VITE_ADSENSE_SLOT_STUDIO=""

#Media APIs (Server-side only)
#If omitted, customers can supply personal keys in the studio settings modal.
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
#Note: Speechify narration uses a customer-supplied browser key in the studio settings modal; no server key is read.

#Email delivery
#EMAIL_PROVIDER can be "console" for local development or "resend" for production.
EMAIL_PROVIDER="console"
EMAIL_FROM="Scenering <noreply@scenering.com>"
EMAIL_REPLY_TO="support@scenering.com"
RESEND_API_KEY=""
#Optional: Resend webhook signing secret (whsec_...) for POST /api/webhooks/resend
#so delivered/bounced/complained events update Email Centre recipient statuses.
RESEND_WEBHOOK_SECRET=""

#FastSpring Billing (Merchant of Record — see FASTSPRING.md)
#Complete FastSpring setup steps:
#1. In the FastSpring app, open Checkouts → Popup Checkouts and create (or open)
#   your popup storefront. Copy the `data-storefront` value into
#   FASTSPRING_STOREFRONT below — e.g.
#     scenering.test.onfastspring.com/popup-scenering   (test orders)
#     scenering.onfastspring.com/popup-scenering        (live orders)
#   Whitelist your domain (and http://localhost:3000 for local testing) on the
#   popup checkout's settings page.
#2. Under Products → Subscriptions, create the four subscription products with
#   these exact product paths (or rename them with the *_PATH vars below):
#     sceneflow-monthly    — $19 / month
#     sceneflow-yearly     — $180 / year
#     sceneforge-monthly   — $39 / month
#     sceneforge-yearly    — $372 / year
#3. Under Developer Tools → Webhooks, add a URL webhook pointing at:
#     https://your-domain.example/api/webhooks/fastspring
#   Enable these six events:
#     subscription.activated, subscription.updated,
#     subscription.charge.completed, subscription.charge.failed,
#     subscription.canceled, subscription.deactivated
#   Set an HMAC SHA256 Secret on that webhook and put the same string in
#   FASTSPRING_WEBHOOK_SECRET below.
#4. (Optional) Under Developer Tools → APIs → API Credentials, create a
#   username and password and put them in FASTSPRING_API_USERNAME and
#   FASTSPRING_API_PASSWORD. When set, Scenering creates server-side `/sessions`
#   checkouts and opens authenticated Account Management URLs directly; without
#   them, popup checkout via FastSpring's Store Builder Library is used.
FASTSPRING_STOREFRONT=""
FASTSPRING_WEBHOOK_SECRET=""
FASTSPRING_API_USERNAME=""
FASTSPRING_API_PASSWORD=""
# FASTSPRING_CHECKOUT_MODE="popup"
FASTSPRING_SCENEFLOW_MONTHLY_PATH="sceneflow-monthly"
FASTSPRING_SCENEFLOW_YEARLY_PATH="sceneflow-yearly"
FASTSPRING_SCENEFORGE_MONTHLY_PATH="sceneforge-monthly"
FASTSPRING_SCENEFORGE_YEARLY_PATH="sceneforge-yearly"
