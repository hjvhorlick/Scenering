# Optional media providers
PEXELS_API_KEY=
PIXABAY_API_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Hosted account/session configuration
PUBLIC_APP_URL=
SESSION_SECRET=
# Exact email address for Henry John Vincent Horlick's owner-admin account.
# Only this server-side address receives administrator role and SceneForge access.
SCENERING_OWNER_EMAIL=

# Email delivery. Production uses Resend's HTTPS API (compatible with
# Cloudflare Workers); keep EMAIL_PROVIDER=console if you only want messages
# printed locally. RESEND_API_KEY is a server-side secret: put it in .dev.vars
# for local Resend testing, or set it in Cloudflare from your own terminal.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Optional Reply-To address for outbound mail (transactional and marketing).
EMAIL_REPLY_TO=
# Optional: Resend delivery webhook signing secret (the whsec_... value from
# Resend's dashboard). When set, delivered/bounced/unsubscribed events are
# verified and recorded against campaign deliveries, upgrading the Email
# Centre's history from "accepted by provider" to real delivery counts.
RESEND_WEBHOOK_SECRET=

# Paddle Billing — server-side secrets and runtime configuration.
# Paddle is the merchant of record: it takes the card, charges the sales tax
# and pays Scenering. Nothing here is VITE_-prefixed or baked into the client
# bundle; only the public client-side token (PADDLE_CLIENT_TOKEN) is served at
# runtime by GET /api/billing/public-config, and PADDLE_API_KEY never leaves
# the server.
#
# On Cloudflare Workers these are set with `wrangler secret put <NAME>`
# (locally they go in .dev.vars); this file documents the names and the loop.
# The full runbook, including the AI agent skills and MCP servers, is PADDLE.md.
#
# Going live, in order:
#  1. Set PADDLE_ENVIRONMENT to live (and PADDLE_CLIENT_ENVIRONMENT to
#     production) for your live Paddle account, or sandbox + sandbox while
#     testing against your sandbox account. They are separate Paddle accounts
#     with separate keys and separate price ids, so every value below exists
#     twice — once per environment.
#  2. Create one product per plan (SceneFlow, SceneForge) with a monthly and a
#     yearly price. Copy each price's id (pri_...) into the PRICE_ID entries
#     below. This is how a payment is mapped back to a Scenering plan.
#  3. Register one approved checkout URL in Paddle (Account settings ->
#     Checkout settings) and copy it into the four CHECKOUT_URL entries, and
#     set your default payment link under Checkout -> Checkout configuration
#     to your live checkout page (e.g. https://scenering.com/pricing).
#  4. Copy your secret API key into PADDLE_API_KEY. The server needs it to
#     create transactions and to read back a subscription's management
#     links (cancel / update card), which Paddle does not put in webhooks.
#  5. Add a notification destination (Paddle -> Events -> Notifications)
#     pointing at  <PUBLIC_APP_URL>/api/webhooks/paddle  and subscribe to every
#     event listed here:
#       subscription.activated, subscription.created, subscription.updated,
#       subscription.canceled, subscription.paused, subscription.resumed,
#       subscription.trialing, subscription.past_due, subscription.imported,
#       customer.created, customer.updated
#     Put the destination's secret key (pdl_ntfset_...) in PADDLE_WEBHOOK_SECRET.
#     Each destination has its own secret, and it is NOT the same value as the
#     API key. Live keys look like pdl_live_apikey_... (sandbox:
#     pdl_sdbx_apikey_...) and are created under Paddle -> My account ->
#     Settings -> Authentication. Webhooks are verified with HMAC-SHA256 over
#     `ts:rawBody` against the h1 part of the Paddle-Signature header.
#  6. Sign in as the owner and open Account & Membership -> Owner
#     administration. The Paddle billing panel shows a checklist of exactly
#     what is still missing, the webhook URL to paste, and the last webhooks
#     received with their outcome.
PADDLE_ENVIRONMENT=live
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_SCENEFLOW_MONTHLY_PRICE_ID=
PADDLE_SCENEFLOW_YEARLY_PRICE_ID=
PADDLE_SCENEFORGE_MONTHLY_PRICE_ID=
PADDLE_SCENEFORGE_YEARLY_PRICE_ID=
PADDLE_SCENEFLOW_MONTHLY_CHECKOUT_URL=
PADDLE_SCENEFLOW_YEARLY_CHECKOUT_URL=
PADDLE_SCENEFORGE_MONTHLY_CHECKOUT_URL=
PADDLE_SCENEFORGE_YEARLY_CHECKOUT_URL=
# 3b. Create a live client-side token (live_...) under Paddle -> Developer
#     tools -> Authentication -> Client-side tokens (or My account -> Settings
#     -> Authentication -> Client-side tokens) for the pricing page, which
#     previews prices and opens checkout in the browser with
#     @paddle/paddle-js. The token is public by design and is served to
#     the browser by GET /api/billing/public-config — never put the
#     secret API key in a client-visible variable. PADDLE_CLIENT_
#     ENVIRONMENT is the value Paddle.js expects ("production" for live, or
#     "sandbox" for sandbox) and must match both the token prefix (live_ vs
#     test_) and PADDLE_ENVIRONMENT above. The endpoint refuses to answer when
#     any value is unset or mismatched, so the wrong account can never be
#     charged.
PADDLE_CLIENT_TOKEN=
PADDLE_CLIENT_ENVIRONMENT=production

# Optional defence in depth. Set to "on" to refuse webhook deliveries that do
# not come from the source ranges Paddle publishes at GET /ips. Off by default:
# the HMAC signature is what authenticates a delivery, and turning this on adds
# a runtime dependency on reaching Paddle. It fails open — if the ranges cannot
# be fetched, deliveries are accepted on their signature and a warning is
# logged, because dropping a real payment is worse than accepting an unverified
# one that the signature check will then reject anyway.
# PADDLE_WEBHOOK_IP_ALLOWLIST=on
# How long a fetched range list is trusted, in milliseconds (default 86400000 =
# 24 hours). Paddle can change the list, so it is re-fetched rather than stored.
# PADDLE_IPS_REFRESH_MS=86400000

# ---------------------------------------------------------------------------
# FastSpring (optional second merchant of record, running alongside Paddle)
# ---------------------------------------------------------------------------
# The full runbook is FASTSPRING.md. In short, in the FastSpring app:
#  1. Create four subscription products (Store > Products):
#       sceneflow-monthly  $19 / month      sceneflow-yearly  $180 / year
#       sceneforge-monthly $39 / month      sceneforge-yearly $372 / year
#     The product paths are what webhooks carry; rename them with the
#     FASTSPRING_*_PATH variables at the bottom of this section.
#  2. Build a Popup Storefront (Checkouts > Popup Checkouts) and copy the
#     data-storefront value from "Place on your Website" into
#     FASTSPRING_STOREFRONT (e.g. scenering.onfastspring.com/popup-scenering).
#     Keep the .test. in the host (scenering.test.onfastspring.com/...) while
#     testing, and whitelist https://scenering.com on the checkout.
#  3. Developer Tools > Webhooks > Add URL, pointing at
#     https://scenering.com/api/webhooks/fastspring (or your own domain plus
#     /api/webhooks/fastspring). Tick the six subscription events:
#       subscription.activated, subscription.updated,
#       subscription.charge.completed, subscription.charge.failed,
#       subscription.canceled, subscription.deactivated
#     Set the webhook's HMAC SHA256 Secret and put it in
#     FASTSPRING_WEBHOOK_SECRET. Deliveries are verified with HMAC-SHA256 over
#     the raw body, base64-encoded, in the X-FS-Signature header.
#  4. Optional: Developer Tools > API > API Credentials for server-created
#     session checkouts and pre-authenticated Account Management links.
#     Without them the popup checkout still works, and the account links
#     recorded from the webhooks still open FastSpring's portal.
#  5. Sign in as the owner and open Account & Membership -> Owner
#     administration. The FastSpring billing panel shows a checklist of
#     exactly what is still missing and the webhook URL to paste.
#
# BILLING_PROVIDER picks where "Choose plan" sends customers: paddle or
# fastspring. Unset means the provider with server credentials configured,
# Paddle first. Both webhook endpoints stay live either way.
# BILLING_PROVIDER=fastspring
FASTSPRING_STOREFRONT=
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=
FASTSPRING_WEBHOOK_SECRET=
# "popup" opens the Store Builder popup (sbl.min.js) on your page; "session"
# redirects to a server-created checkout URL. Unset means session when the API
# keys are configured, popup otherwise.
# FASTSPRING_CHECKOUT_MODE=popup
# Product paths — these defaults match the products named above; set a variable
# only when the matching product was created with a different path.
# FASTSPRING_SCENEFLOW_MONTHLY_PATH=sceneflow-monthly
# FASTSPRING_SCENEFLOW_YEARLY_PATH=sceneflow-yearly
# FASTSPRING_SCENEFORGE_MONTHLY_PATH=sceneforge-monthly
# FASTSPRING_SCENEFORGE_YEARLY_PATH=sceneforge-yearly
